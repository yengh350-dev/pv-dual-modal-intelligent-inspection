APP_ENV=development
DATABASE_URL=sqlite:///./sentinel.db
JWT_SECRET=change-this-in-production-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
ALLOWED_ORIGINS=http://localhost:5173

# 多模型路由。未配置密钥的提供商不会出现在可选列表中。
AI_DEFAULT_PROVIDER=demo
AI_REQUEST_TIMEOUT_SECONDS=30

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-2-1-pro-260628

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# 可选：企业自建或其他 OpenAI-compatible 网关。保留旧变量以向后兼容。
AI_PROVIDER=demo
AI_BASE_URL=https://your-gateway.example/v1
AI_API_KEY=
AI_MODEL=your-model-id
